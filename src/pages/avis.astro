---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { avis } from '../data/avis';
import { breadcrumbList, SAME_AS } from '../lib/seo';

const etoiles = (note: number) => '★'.repeat(note) + '☆'.repeat(5 - note);
---

<PageLayout
  title="Avis — Ce que disent nos adhérents | Lifitness Dakar"
  description="Découvrez les retours des adhérents Lifitness Dakar : Carte Confort, coachs, boxe, EMS, piscine. Des expériences réelles aux Almadies et à Sacré-Cœur 3."
  path="/avis"
  jsonLd={breadcrumbList([
    { name: 'Accueil', path: '/' },
    { name: 'Avis', path: '/avis' },
  ])}
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6">
    <SectionHeader
      eyebrow="Avis"
      title="Ils s'entraînent chez nous. Ils en parlent."
      subtitle="Des adhérents des Almadies, de Sacré-Cœur et d'ailleurs à Dakar partagent leur expérience. Sans filtre."
    />

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {avis.map((a) => (
        <Card class="flex h-full flex-col">
          <p
            class="font-mono text-sm text-brand-amber"
            aria-label={`Note : ${a.note} sur 5`}
          >
            {etoiles(a.note)}
          </p>
          <blockquote class="mt-4 flex-1 text-sm text-light-primary/80 pretty">
            « {a.texte} »
          </blockquote>
          <footer class="mt-5 font-mono text-xs text-light-primary/55">
            {a.nom} — {a.quartier}
          </footer>
        </Card>
      ))}
    </div>

    <!-- PLACEHOLDER : avis d'exemple rédigés pour la maquette.
         À remplacer par de vrais avis Google Business / Facebook avant production. -->
    <p class="mt-8 text-center text-xs text-light-primary/45">
      Témoignages collectés auprès de nos adhérents. Retrouvez aussi nos
      publications sur les réseaux sociaux.
    </p>

    <div class="mt-12 flex flex-col items-center gap-4 rounded-card border border-white/10 bg-dark-secondary p-8 text-center">
      <h2 class="text-xl font-bold">Déjà adhérent ? Votre avis compte.</h2>
      <p class="max-w-md text-sm text-light-primary/70">
        Laissez un avis sur notre page Facebook — cela aide d'autres sportifs à
        franchir le pas.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        {SAME_AS.map((url) => (
          <Button href={url} variant="ghost" external>
            {url.includes('facebook') ? 'Avis Facebook' : 'Instagram'}
          </Button>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA />
</PageLayout>
