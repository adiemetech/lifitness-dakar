---
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Card from '../../../components/ui/Card.astro';
import FinalCTA from '../../../components/sections/FinalCTA.astro';
import { breadcrumbList } from '../../../lib/seo';

const posts = (await getCollection('blogEn', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formater = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<PageLayout
  lang="en"
  title="Blog — Training & nutrition tips | Lifitness Dakar"
  description="The Lifitness Dakar blog: practical guides on boxing, EMS, strength training and sports nutrition with local foods. Direct advice you can apply today."
  path="/en/blog"
  jsonLd={breadcrumbList([
    { name: 'Home', path: '/en/' },
    { name: 'Blog', path: '/en/blog' },
  ])}
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6">
    <SectionHeader
      eyebrow="Blog"
      title="Direct advice. Zero fluff."
      subtitle="Training, nutrition, recovery: what our coaches repeat every day on the floor, written down."
    />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {posts.map((post) => (
        <a href={`/en/blog/${post.id}`} class="group block h-full">
          <Card class="flex h-full flex-col transition group-hover:border-brand-magenta/50">
            <p class="font-mono text-xs text-light-primary/55">
              {formater.format(post.data.date)}
            </p>
            <h2 class="mt-3 text-xl font-bold group-hover:text-brand-pink">
              {post.data.title}
            </h2>
            <p class="mt-3 flex-1 text-sm text-light-primary/70 pretty">
              {post.data.description}
            </p>
            <p class="mt-5 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="rounded-pill border border-white/15 bg-black/30 px-3 py-1 font-mono text-xs text-brand-cyan">
                  {tag}
                </span>
              ))}
            </p>
            <p class="mt-5 font-mono text-xs text-brand-magenta">
              Read the article →
            </p>
          </Card>
        </a>
      ))}
    </div>
  </section>

  <FinalCTA lang="en" />
</PageLayout>
