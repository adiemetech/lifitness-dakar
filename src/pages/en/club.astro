---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import StatBlock from '../../components/ui/StatBlock.astro';
import Button from '../../components/ui/Button.astro';
import CarteConfort from '../../components/sections/CarteConfort.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { breadcrumbList, healthAndBeautyBusiness } from '../../lib/seo';
import { sallesEn } from '../../data/en/salles';
import boutiqueImg from '../../assets/images/boutique/lifitness-bar.png';
import salleImg from '../../assets/images/hero/hero-halteres-miroir.jpg';

const stats = [
  { valeur: '2', label: 'Gyms in Dakar' },
  { valeur: '16 h', label: 'Open on weekdays' },
  { valeur: '1', label: 'Membership, zero borders' },
];

const values = [
  {
    titre: 'High standards, no intimidation',
    texte:
      'Premium equipment, serious coaching, but zero arrogance. We welcome the complete beginner and the seasoned athlete with the same energy.',
    accent: 'text-brand-magenta',
  },
  {
    titre: 'Real proximity',
    texte:
      'The coaches know your name, your goals and your weak points. Here, you are not just another badge crossing the floor.',
    accent: 'text-brand-cyan',
  },
  {
    titre: 'Freedom of movement',
    texte:
      'The Comfort Card removes the only constraint that matters: location. Work in Almadies, live in Sacré-Cœur? Both gyms are yours.',
    accent: 'text-brand-amber',
  },
];
---

<PageLayout
  lang="en"
  title="The Club — Our story, our gyms, our vision | Lifitness Dakar"
  description="Lifitness Dakar is a premium multi-gym club in Almadies and Sacré-Cœur 3: strength training, boxing, EMS, aqua, coaches from opening time and one single card for everything."
  path="/en/club"
  jsonLd={[
    breadcrumbList([
      { name: 'Home', path: '/en/' },
      { name: 'The club', path: '/en/club' },
    ]),
    healthAndBeautyBusiness('en'),
  ]}
>
  <section class="relative isolate overflow-hidden">
    <Image
      src={salleImg}
      alt="View of the Lifitness strength floor with mirrors"
      sizes="100vw"
      data-parallax
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-dark-primary via-dark-primary/80 to-dark-primary/50"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex gap-2 font-mono text-xs text-light-primary/60">
          <li>
            <a href="/en/" class="hover:text-brand-pink">
              Home
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="text-light-primary">The club</li>
        </ol>
      </nav>
      <div data-hero-stagger class="flex max-w-2xl flex-col items-start gap-5">
        <Eyebrow>The club</Eyebrow>
        <h1 class="text-4xl font-bold text-balance sm:text-5xl">
          Two gyms. One single obsession:
          <span class="text-gradient">your progress.</span>
        </h1>
        <p class="text-lg text-light-primary/85 pretty">
          Lifitness was born from a simple observation: in Dakar you can find
          gyms, but rarely a club. A place where you are expected, where you are
          coached, and where your membership opens every door.
        </p>
      </div>
      <div class="mt-12 flex flex-wrap gap-x-14 gap-y-8">
        {stats.map((s) => (
          <StatBlock valeur={s.valeur} label={s.label} />
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <SectionHeader
      eyebrow="Our vision"
      title="The premium club, without the protocol"
      subtitle="A space designed for Dakar's demanding athletes: executives, expats, competitors, and everyone who wants a safe and serious place to train."
    />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {values.map((v) => (
        <Card>
          <span
            class:list={['font-mono text-2xl', v.accent]}
            aria-hidden="true"
          >
            ■
          </span>
          <h3 class="mt-3 text-xl font-bold">{v.titre}</h3>
          <p class="mt-2 text-sm text-light-primary/70">{v.texte}</p>
        </Card>
      ))}
    </div>
  </section>

  <section class="bg-dark-secondary/60">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-2">
      <div>
        <Eyebrow>Our gyms</Eyebrow>
        <h2 class="mt-4 text-3xl font-bold text-balance">
          Almadies facing the Corniche. Sacré-Cœur behind the Auchan.
        </h2>
        <p class="mt-4 text-light-primary/75 pretty">
          Two addresses, two vibes, one single membership. The Almadies flagship
          lines up full floors, a boxing ring, an aqua area and a sauna.
          Sacré-Cœur 3 brings the neighbourhood energy: strength training,
          cardio, group classes and personal coaching.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href="/en/gyms">Discover the gyms</Button>
          <Button href="/en/gallery" variant="outline">
            View the gallery
          </Button>
        </div>
      </div>
      <Image
        src={boutiqueImg}
        alt="Lifitness bar, the club's visual identity"
        class="w-full rounded-card border border-white/10 object-cover"
      />
    </div>
  </section>

  <CarteConfort lang="en" />

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <div class="grid gap-6 sm:grid-cols-2">
      {sallesEn.map((salle) => (
        <Card>
          <h3 class="text-xl font-bold">{salle.nom}</h3>
          <p class="mt-2 font-mono text-xs text-light-primary/55">
            {salle.adresse} — {salle.complement}
          </p>
          <p class="mt-3 text-sm text-light-primary/70">{salle.description}</p>
          <a
            href={`/en/gyms/${salle.slug}`}
            class="mt-4 inline-block font-mono text-xs text-brand-magenta hover:text-brand-pink"
          >
            Gym profile →
          </a>
        </Card>
      ))}
    </div>
  </section>

  <FinalCTA lang="en" />
</PageLayout>
