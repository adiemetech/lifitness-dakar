---
import PageLayout from '../../../layouts/PageLayout.astro';
import Eyebrow from '../../../components/ui/Eyebrow.astro';
import Button from '../../../components/ui/Button.astro';
import MapEmbed from '../../../components/sections/MapEmbed.astro';
import FinalCTA from '../../../components/sections/FinalCTA.astro';
import { telHref } from '../../../data/salles';
import { sallesEn, getSalleEn } from '../../../data/en/salles';
import { horaires, horairesNoteEn } from '../../../data/horaires';
import { programmesEn } from '../../../data/en/programmes';
import { breadcrumbList, localBusiness } from '../../../lib/seo';

export function getStaticPaths() {
  return sallesEn.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const salle = getSalleEn(slug!);
---

<PageLayout
  lang="en"
  title={`${salle.nom} — Gym in Dakar | Lifitness`}
  description={`${salle.nom}: ${salle.adresse}, ${salle.complement}. ${salle.description}`}
  path={`/en/gyms/${salle.slug}`}
  jsonLd={[
    breadcrumbList([
      { name: 'Home', path: '/en/' },
      { name: 'Gyms', path: '/en/gyms' },
      { name: salle.nom, path: `/en/gyms/${salle.slug}` },
    ]),
    localBusiness(salle.slug, 'en'),
  ]}
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex gap-2 font-mono text-xs text-light-primary/60">
        <li>
          <a href="/en/" class="hover:text-brand-pink">
            Home
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/en/gyms" class="hover:text-brand-pink">
            Gyms
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-light-primary">{salle.nom}</li>
      </ol>
    </nav>
    <div class="flex max-w-2xl flex-col items-start gap-5">
      <Eyebrow>Lifitness gym</Eyebrow>
      <h1 class="text-4xl font-bold text-balance sm:text-5xl">{salle.nom}</h1>
      <p class="text-lg text-light-primary/85 pretty">{salle.description}</p>
      <div class="flex flex-wrap gap-4">
        <Button href="/en/free-trial">Book my trial session</Button>
        <Button href={telHref(salle)} variant="outline">
          {salle.telephone}
        </Button>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 pb-20 sm:px-6 lg:grid-cols-2">
    <div class="flex flex-col gap-8">
      <div class="rounded-card border border-white/10 bg-dark-secondary p-7">
        <h2 class="text-xl font-bold">Address</h2>
        <p class="mt-3 text-light-primary/80">
          {salle.adresse}
          <br />
          {salle.complement}
        </p>
        {salle.gps && (
          <p class="mt-3 font-mono text-xs text-light-primary/50">
            GPS: {salle.gps.lat}, {salle.gps.lng} (to be confirmed)
          </p>
        )}
      </div>
      <div class="rounded-card border border-white/10 bg-dark-secondary p-7">
        <h2 class="text-xl font-bold">Opening hours</h2>
        <ul class="mt-4 flex flex-col gap-2 text-sm">
          {horaires.map((c) => (
            <li class="flex justify-between gap-6">
              <span class="text-light-primary/75">{c.labelEn}</span>
              <span class="font-mono">
                {c.opens} – {c.closes}
              </span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-light-primary/60">{horairesNoteEn}</p>
      </div>
      <div class="rounded-card border border-white/10 bg-dark-secondary p-7">
        <h2 class="text-xl font-bold">On site</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {programmesEn.map((p) => (
            <li>
              <a
                href={`/en/programs/${p.slug}`}
                class="rounded-pill border border-white/15 px-3 py-1 font-mono text-xs text-light-primary/75 transition hover:border-brand-magenta hover:text-brand-pink"
              >
                {p.nom}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-light-primary/60">
          Same program in both gyms, included in your Comfort Card.
        </p>
      </div>
    </div>
    <div class="flex flex-col gap-4">
      {salle.gps ? (
        <MapEmbed
          lat={salle.gps.lat}
          lng={salle.gps.lng}
          titre={salle.nom}
          lang="en"
        />
      ) : (
        <div class="grid aspect-[4/3] place-items-center rounded-card border border-dashed border-white/20 p-8 text-center text-sm text-light-primary/60">
          Map coming soon — GPS coordinates being confirmed.
        </div>
      )}
      <p class="text-xs text-light-primary/50">
        Landmark: {salle.complement.toLowerCase()}.
      </p>
    </div>
  </section>

  <FinalCTA lang="en" />
</PageLayout>
