---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { planning } from '../../data/planning';
import { programmesEn } from '../../data/en/programmes';
import { horaires } from '../../data/horaires';
import { sallesEn } from '../../data/en/salles';
import { breadcrumbList, BOOKING_URL } from '../../lib/seo';

const dayToEn: Record<string, string> = {
  Lundi: 'Monday',
  Mardi: 'Tuesday',
  Mercredi: 'Wednesday',
  Jeudi: 'Thursday',
  Vendredi: 'Friday',
  Samedi: 'Saturday',
  Dimanche: 'Sunday',
};

const families = programmesEn.filter((p) =>
  ['crossfit', 'trx', 'boxing', 'ems', 'group-classes', 'aqua'].includes(
    p.slug,
  ),
);
---

<PageLayout
  lang="en"
  title="Schedule — Group classes & booking | Lifitness Dakar"
  description="Lifitness Dakar group class schedule: crossfit, TRX, boxing, EMS, Zumba, Step, Les Mills, aqua gym and aqua bike, in both gyms. Booking via Multiresa."
  path="/en/schedule"
  jsonLd={breadcrumbList([
    { name: 'Home', path: '/en/' },
    { name: 'Schedule', path: '/en/schedule' },
  ])}
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-10 sm:px-6">
    <SectionHeader
      eyebrow="Schedule"
      title="Your whole week, booked in two clicks."
      subtitle="Group classes, EMS sessions and aqua slots are booked through Multiresa Lifitness. The floors stay open-access during opening hours."
    />
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={BOOKING_URL} external>
        Book via Multiresa
      </Button>
      <Button href="/en/contact" variant="outline">
        Request the schedule by message
      </Button>
    </div>
  </section>

  {planning.length > 0 ? (
    <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
      <div class="overflow-x-auto rounded-card border border-white/10">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="bg-dark-secondary font-mono text-xs tracking-widest uppercase text-light-primary/60">
            <tr>
              <th class="px-5 py-4">Day</th>
              <th class="px-5 py-4">Time</th>
              <th class="px-5 py-4">Class</th>
              <th class="px-5 py-4">Gym</th>
            </tr>
          </thead>
          <tbody>
            {planning.map((s) => (
              <tr class="border-t border-white/10">
                <td class="px-5 py-3 font-semibold">
                  {dayToEn[s.jour] ?? s.jour}
                </td>
                <td class="px-5 py-3 font-mono">{s.heure}</td>
                <td class="px-5 py-3">{s.cours}</td>
                <td class="px-5 py-3 text-light-primary/70">
                  {sallesEn.find((x) => x.slug === s.salle)?.nom}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ) : (
    <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {families.map((f) => (
          <Card>
            <p
              class:list={[
                'font-mono text-xs tracking-[0.25em] uppercase',
                f.accent,
              ]}
            >
              {f.categorie}
            </p>
            <h2 class="mt-2 text-lg font-bold">{f.nom}</h2>
            <p class="mt-2 text-sm text-light-primary/70">{f.accroche}</p>
            <a
              href={`/en/programs/${f.slug}`}
              class="mt-4 inline-block text-sm font-semibold text-brand-cyan hover:text-brand-pink"
            >
              Program details →
            </a>
          </Card>
        ))}
      </div>
      <p class="mt-8 rounded-card border border-dashed border-white/20 p-6 text-center text-sm text-light-primary/70">
        The detailed week-by-week timetable is available via Multiresa Lifitness
        and at the reception of both gyms. It will be published here as soon as
        it is provided.
      </p>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 class="mb-6 text-2xl font-bold">Floor opening hours</h2>
    <ul class="grid gap-4 sm:grid-cols-3">
      {horaires.map((c) => (
        <li class="rounded-card border border-white/10 bg-dark-secondary p-5">
          <p class="font-semibold">{c.labelEn}</p>
          <p class="mt-1 font-mono text-brand-cyan">
            {c.opens} – {c.closes}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <FinalCTA lang="en" />
</PageLayout>
