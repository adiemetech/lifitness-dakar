---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { avisEn } from '../../data/en/avis';
import { breadcrumbList, SAME_AS } from '../../lib/seo';

const stars = (note: number) => '★'.repeat(note) + '☆'.repeat(5 - note);
---

<PageLayout
  lang="en"
  title="Reviews — What our members say | Lifitness Dakar"
  description="Discover Lifitness Dakar member feedback: Comfort Card, coaches, boxing, EMS, pool. Real experiences in Almadies and Sacré-Cœur 3."
  path="/en/reviews"
  jsonLd={breadcrumbList([
    { name: 'Home', path: '/en/' },
    { name: 'Reviews', path: '/en/reviews' },
  ])}
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6">
    <SectionHeader
      eyebrow="Reviews"
      title="They train with us. They talk about it."
      subtitle="Members from Almadies, Sacré-Cœur and across Dakar share their experience. Unfiltered."
    />

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {avisEn.map((a) => (
        <Card class="flex h-full flex-col">
          <p
            class="font-mono text-sm text-brand-amber"
            aria-label={`Rating: ${a.note} out of 5`}
          >
            {stars(a.note)}
          </p>
          <blockquote class="mt-4 flex-1 text-sm text-light-primary/80 pretty">
            “{a.texte}”
          </blockquote>
          <footer class="mt-5 font-mono text-xs text-light-primary/55">
            {a.nom} — {a.quartier}
          </footer>
        </Card>
      ))}
    </div>

    <p class="mt-8 text-center text-xs text-light-primary/45">
      Testimonials collected from our members. Also find our posts on social
      media.
    </p>

    <div class="mt-12 flex flex-col items-center gap-4 rounded-card border border-white/10 bg-dark-secondary p-8 text-center">
      <h2 class="text-xl font-bold">Already a member? Your review matters.</h2>
      <p class="max-w-md text-sm text-light-primary/70">
        Leave a review on our Facebook page — it helps other athletes take the
        plunge.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        {SAME_AS.map((url) => (
          <Button href={url} variant="ghost" external>
            {url.includes('facebook') ? 'Facebook reviews' : 'Instagram'}
          </Button>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA lang="en" />
</PageLayout>
