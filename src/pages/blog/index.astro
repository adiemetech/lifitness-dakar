---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Card from '../../components/ui/Card.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { breadcrumbList } from '../../lib/seo';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formater = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<PageLayout
  title="Blog — Conseils entraînement & nutrition | Lifitness Dakar"
  description="Le blog Lifitness Dakar : guides pratiques boxe, EMS, musculation, nutrition sportive avec les produits locaux. Des conseils directs, applicables dès aujourd'hui."
  path="/blog"
  jsonLd={breadcrumbList([
    { name: 'Accueil', path: '/' },
    { name: 'Blog', path: '/blog' },
  ])}
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6">
    <SectionHeader
      eyebrow="Blog"
      title="Des conseils directs. Zéro blabla."
      subtitle="Entraînement, nutrition, récupération : ce que nos coachs répètent tous les jours en salle, écrit noir sur blanc."
    />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="group block h-full">
          <Card class="flex h-full flex-col transition group-hover:border-brand-magenta/50">
            <p class="font-mono text-xs text-light-primary/55">
              {formater.format(post.data.date)}
            </p>
            <h2 class="mt-3 text-xl font-bold group-hover:text-brand-pink">
              {post.data.title}
            </h2>
            <p class="mt-3 flex-1 text-sm text-light-primary/70 pretty">
              {post.data.description}
            </p>
            <p class="mt-5 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="rounded-pill border border-white/15 bg-black/30 px-3 py-1 font-mono text-xs text-brand-cyan">
                  {tag}
                </span>
              ))}
            </p>
            <p class="mt-5 font-mono text-xs text-brand-magenta">
              Lire l'article →
            </p>
          </Card>
        </a>
      ))}
    </div>
  </section>

  <FinalCTA />
</PageLayout>
