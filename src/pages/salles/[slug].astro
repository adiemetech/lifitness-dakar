---
import PageLayout from '../../layouts/PageLayout.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Button from '../../components/ui/Button.astro';
import MapEmbed from '../../components/sections/MapEmbed.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { salles, getSalle, telHref } from '../../data/salles';
import { horaires, horairesNote } from '../../data/horaires';
import { programmes } from '../../data/programmes';
import { breadcrumbList, localBusiness } from '../../lib/seo';

export function getStaticPaths() {
  return salles.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const salle = getSalle(slug!);
---

<PageLayout
  title={`${salle.nom} — Salle de sport à Dakar | Lifitness`}
  description={`${salle.nom} : ${salle.adresse}, ${salle.complement}. ${salle.description}`}
  path={`/salles/${salle.slug}`}
  jsonLd={[
    breadcrumbList([
      { name: 'Accueil', path: '/' },
      { name: 'Salles', path: '/salles' },
      { name: salle.nom, path: `/salles/${salle.slug}` },
    ]),
    localBusiness(salle.slug),
  ]}
>
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-10 sm:px-6">
    <nav aria-label="Fil d'Ariane" class="mb-6">
      <ol class="flex gap-2 font-mono text-xs text-light-primary/60">
        <li>
          <a href="/" class="hover:text-brand-pink">
            Accueil
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/salles" class="hover:text-brand-pink">
            Salles
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-light-primary">{salle.nom}</li>
      </ol>
    </nav>
    <div class="flex max-w-2xl flex-col items-start gap-5">
      <Eyebrow>Salle Lifitness</Eyebrow>
      <h1 class="text-4xl font-bold text-balance sm:text-5xl">{salle.nom}</h1>
      <p class="text-lg text-light-primary/85 pretty">{salle.description}</p>
      <div class="flex flex-wrap gap-4">
        <Button href="/essai-gratuit">Réserver ma séance d'essai</Button>
        <Button href={telHref(salle)} variant="outline">
          {salle.telephone}
        </Button>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 pb-20 sm:px-6 lg:grid-cols-2">
    <div class="flex flex-col gap-8">
      <div class="rounded-card border border-white/10 bg-dark-secondary p-7">
        <h2 class="text-xl font-bold">Adresse</h2>
        <p class="mt-3 text-light-primary/80">
          {salle.adresse}
          <br />
          {salle.complement}
        </p>
        {salle.gps && (
          <p class="mt-3 font-mono text-xs text-light-primary/50">
            GPS : {salle.gps.lat}, {salle.gps.lng} (à valider)
          </p>
        )}
      </div>
      <div class="rounded-card border border-white/10 bg-dark-secondary p-7">
        <h2 class="text-xl font-bold">Horaires</h2>
        <ul class="mt-4 flex flex-col gap-2 text-sm">
          {horaires.map((c) => (
            <li class="flex justify-between gap-6">
              <span class="text-light-primary/75">{c.label}</span>
              <span class="font-mono">
                {c.opens.replace(':', 'h')} – {c.closes.replace(':', 'h')}
              </span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-light-primary/60">{horairesNote}</p>
      </div>
      <div class="rounded-card border border-white/10 bg-dark-secondary p-7">
        <h2 class="text-xl font-bold">Sur place</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {programmes.map((p) => (
            <li>
              <a
                href={`/programmes/${p.slug}`}
                class="rounded-pill border border-white/15 px-3 py-1 font-mono text-xs text-light-primary/75 transition hover:border-brand-magenta hover:text-brand-pink"
              >
                {p.nom}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-light-primary/60">
          Programme commun aux deux salles, inclus dans votre Carte Confort.
        </p>
      </div>
    </div>
    <div class="flex flex-col gap-4">
      {salle.gps ? (
        <MapEmbed lat={salle.gps.lat} lng={salle.gps.lng} titre={salle.nom} />
      ) : (
        <div class="grid aspect-[4/3] place-items-center rounded-card border border-dashed border-white/20 p-8 text-center text-sm text-light-primary/60">
          Carte à venir — coordonnées GPS en cours de validation.
        </div>
      )}
      <p class="text-xs text-light-primary/50">
        Repère : {salle.complement.toLowerCase()}.
      </p>
    </div>
  </section>

  <FinalCTA />
</PageLayout>
