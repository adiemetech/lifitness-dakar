---
import { Image } from 'astro:assets';
import fullLogo from '../../assets/logo/lifitness-logo-full.png';
import { mainNav, secondaryNav, legalNav } from '../../data/navigation';
import { salles, telHref } from '../../data/salles';
import { horaires, horairesNote, horairesNoteEn } from '../../data/horaires';
import { SITE_EMAIL, SAME_AS, BOOKING_URL } from '../../lib/seo';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routes';

interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
const annee = new Date().getFullYear();

const formatTime = (time: string) =>
  lang === 'en' ? time : time.replace(':', 'h');
---

<footer class="border-t border-white/10 bg-dark-secondary">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-4">
    <div class="flex flex-col gap-4">
      <Image
        src={fullLogo}
        alt="Lifitness Dakar"
        width={260}
        height={156}
        class="h-16 w-auto"
      />
      <p class="text-sm text-light-primary/70 pretty">{t('footer.tagline')}</p>
      <div class="flex gap-3">
        <a
          href={SAME_AS[0]}
          target="_blank"
          rel="noopener"
          aria-label={t('footer.facebookAria')}
          class="grid size-10 place-items-center rounded-card border border-white/15 transition hover:border-brand-magenta hover:text-brand-pink"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5V11H8.5v3H11v7h2.5Z" />
          </svg>
        </a>
        <a
          href={SAME_AS[1]}
          target="_blank"
          rel="noopener"
          aria-label={t('footer.instagramAria')}
          class="grid size-10 place-items-center rounded-card border border-white/15 transition hover:border-brand-magenta hover:text-brand-pink"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 4.3c2.5 0 2.8 0 3.8.06 2.5.11 3.7 1.3 3.8 3.8.05 1 .06 1.3.06 3.8s0 2.8-.06 3.8c-.11 2.5-1.3 3.7-3.8 3.8-1 .05-1.3.06-3.8.06s-2.8 0-3.8-.06c-2.5-.11-3.7-1.3-3.8-3.8-.05-1-.06-1.3-.06-3.8s0-2.8.06-3.8c.11-2.5 1.3-3.7 3.8-3.8 1-.05 1.3-.06 3.8-.06Zm0-2.3C9.4 2 9.1 2 8.1 2.06 4.5 2.22 2.22 4.5 2.06 8.1 2 9.1 2 9.4 2 12s0 2.9.06 3.9c.16 3.6 2.44 5.88 6.04 6.04 1 .06 1.3.06 3.9.06s2.9 0 3.9-.06c3.6-.16 5.88-2.44 6.04-6.04.06-1 .06-1.3.06-3.9s0-2.9-.06-3.9C21.78 4.5 19.5 2.22 15.9 2.06 14.9 2 14.6 2 12 2Zm0 6.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm0 6.3a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Zm4.8-6.5a.9.9 0 1 1-1.8 0 .9.9 0 0 1 1.8 0Z" />
          </svg>
        </a>
      </div>
    </div>

    <nav aria-label={t('nav.footerAria')}>
      <p class="mb-4 font-mono text-xs tracking-[0.3em] text-brand-cyan uppercase">
        {t('footer.explore')}
      </p>
      <ul class="flex flex-col gap-2 text-sm">
        {[...mainNav, ...secondaryNav].map((item) => (
          <li>
            <a
              href={localizedPath(item.href, lang)}
              class="text-light-primary/70 transition hover:text-brand-pink"
            >
              {t(item.labelKey)}
            </a>
          </li>
        ))}
        <li>
          <a
            href={BOOKING_URL}
            class="text-light-primary/70 transition hover:text-brand-pink"
          >
            {t('footer.booking')}
          </a>
        </li>
      </ul>
    </nav>

    <div>
      <p class="mb-4 font-mono text-xs tracking-[0.3em] text-brand-cyan uppercase">
        {t('footer.ourGyms')}
      </p>
      <ul class="flex flex-col gap-4 text-sm text-light-primary/70">
        {salles.map((salle) => (
          <li>
            <a
              href={localizedPath(`/salles/${salle.slug}`, lang)}
              class="font-semibold text-light-primary transition hover:text-brand-pink"
            >
              {salle.nom}
            </a>
            <p>{salle.adresse}</p>
            <p>{salle.complement}</p>
            <a
              href={telHref(salle)}
              class="font-mono transition hover:text-brand-pink"
            >
              {salle.telephone}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="mb-4 font-mono text-xs tracking-[0.3em] text-brand-cyan uppercase">
        {t('footer.hoursContact')}
      </p>
      <ul class="flex flex-col gap-1 text-sm text-light-primary/70">
        {horaires.map((c) => (
          <li class="flex justify-between gap-4">
            <span>{lang === 'en' ? c.labelEn : c.label}</span>
            <span class="font-mono">
              {formatTime(c.opens)} – {formatTime(c.closes)}
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-2 text-sm text-light-primary/70">
        {lang === 'en' ? horairesNoteEn : horairesNote}
      </p>
      <a
        href={`mailto:${SITE_EMAIL}`}
        class="mt-4 inline-block font-mono text-sm transition hover:text-brand-pink"
      >
        {SITE_EMAIL}
      </a>
    </div>
  </div>

  <div class="border-t border-white/10 px-4 py-5 sm:px-6">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 text-xs text-light-primary/50 sm:flex-row">
      <p>
        © {annee} Lifitness Dakar. {t('footer.rights')}
      </p>
      <ul class="flex gap-4">
        {legalNav.map((item) => (
          <li>
            <a
              href={localizedPath(item.href, lang)}
              class="transition hover:text-brand-pink"
            >
              {t(item.labelKey)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
