---
import Button from '../ui/Button.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routes';

interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-dark-primary/95 p-3 backdrop-blur md:hidden">
  <Button href={localizedPath('/essai-gratuit', lang)} class="w-full">
    {t('cta.bookTrial')}
  </Button>
</div>
