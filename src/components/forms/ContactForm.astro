---
import { sallesLabels } from '../../lib/form';
import { SITE_EMAIL } from '../../lib/seo';
import type { Lang } from '../../i18n/ui';

export interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const en = lang === 'en';

const inputClass =
  'w-full rounded-card border border-white/15 bg-dark-primary px-4 py-3 text-sm text-light-primary placeholder:text-light-primary/40 focus:border-brand-magenta focus:outline-none';
const labelClass =
  'mb-1 block font-mono text-xs tracking-widest uppercase text-light-primary/70';
const errorClass = 'mt-1 hidden font-mono text-xs text-brand-orange';
---

<form data-contact-form data-lang={lang} class="flex flex-col gap-5" novalidate>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="contact-nom" class={labelClass}>
        {en ? 'Name *' : 'Nom *'}
      </label>
      <input
        id="contact-nom"
        name="nom"
        type="text"
        autocomplete="name"
        required
        class={inputClass}
        placeholder="Awa Diop"
      />
      <p data-error="nom" class={errorClass}></p>
    </div>
    <div>
      <label for="contact-tel" class={labelClass}>
        {en ? 'Phone *' : 'Téléphone *'}
      </label>
      <input
        id="contact-tel"
        name="telephone"
        type="tel"
        autocomplete="tel"
        required
        class={inputClass}
        placeholder="77 123 45 67"
      />
      <p data-error="telephone" class={errorClass}></p>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="contact-email" class={labelClass}>
        {en ? 'Email (optional)' : 'Email (optionnel)'}
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        class={inputClass}
        placeholder={en ? 'you@example.com' : 'vous@exemple.com'}
      />
      <p data-error="email" class={errorClass}></p>
    </div>
    <div>
      <label for="contact-salle" class={labelClass}>
        {en ? 'Which gym? *' : 'Quelle salle ? *'}
      </label>
      <select id="contact-salle" name="salle" required class={inputClass}>
        {Object.entries(sallesLabels).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
      <p data-error="salle" class={errorClass}></p>
    </div>
  </div>

  <div>
    <label for="contact-message" class={labelClass}>
      Message *
    </label>
    <textarea
      id="contact-message"
      name="message"
      rows="5"
      required
      class={inputClass}
      placeholder={
        en ? 'Your question, what you need…' : 'Votre question, votre besoin…'
      }
    ></textarea>
    <p data-error="message" class={errorClass}></p>
  </div>

  <button
    type="submit"
    class="rounded-pill bg-gradient-brand px-8 py-4 text-base font-semibold text-white transition hover:-translate-y-0.5 hover:brightness-110"
  >
    {en ? 'Send message' : 'Envoyer le message'}
  </button>
  <p class="text-xs text-light-primary/55">
    {en ? (
      <>
        * Required fields. Sent via pre-filled WhatsApp, email copy to
        {SITE_EMAIL} offered at confirmation.
      </>
    ) : (
      <>
        * Champs obligatoires. Envoi via WhatsApp prérempli, copie email vers
        {SITE_EMAIL} proposée à la confirmation.
      </>
    )}
  </p>

  <div
    data-contact-success
    class="hidden flex-col gap-4 rounded-card border border-brand-cyan/40 bg-brand-cyan/10 p-6"
    role="status"
  >
    <p class="font-semibold text-brand-cyan">
      {en ? 'Message ready to send.' : 'Message prêt à partir.'}
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        data-success-whatsapp
        href="#"
        target="_blank"
        rel="noopener"
        class="rounded-pill bg-[#25D366] px-5 py-2.5 text-sm font-semibold text-white"
      >
        {en ? 'Open WhatsApp' : 'Ouvrir WhatsApp'}
      </a>
      <a
        data-success-mailto
        href="#"
        class="rounded-pill border border-white/25 px-5 py-2.5 text-sm font-semibold"
      >
        {en ? 'Send by email' : 'Envoyer par email'}
      </a>
      <button
        type="button"
        data-success-copy
        class="rounded-pill border border-white/25 px-5 py-2.5 text-sm font-semibold"
      >
        {en ? 'Copy message' : 'Copier le message'}
      </button>
    </div>
  </div>
</form>

<script>
  import {
    contactSchema,
    contactSchemaEn,
    buildContactMessage,
  } from '../../lib/form';
  import { whatsappUrl } from '../../lib/whatsapp';
  import { SITE_EMAIL } from '../../lib/seo';
  import { trackEvent, EVENTS } from '../../lib/analytics';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const lang = form.dataset.lang === 'en' ? 'en' : 'fr';
    const schema = lang === 'en' ? contactSchemaEn : contactSchema;
    const success = form.querySelector<HTMLElement>('[data-contact-success]');
    const waLink = form.querySelector<HTMLAnchorElement>(
      '[data-success-whatsapp]',
    );
    const mailtoLink = form.querySelector<HTMLAnchorElement>(
      '[data-success-mailto]',
    );
    const copyBtn = form.querySelector<HTMLButtonElement>(
      '[data-success-copy]',
    );

    const clearErrors = () =>
      form.querySelectorAll('[data-error]').forEach((el) => {
        el.textContent = '';
        el.classList.add('hidden');
      });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearErrors();
      const data = Object.fromEntries(new FormData(form).entries());
      const result = schema.safeParse(data);
      if (!result.success) {
        for (const issue of result.error.issues) {
          const field = String(issue.path[0]);
          const target = form.querySelector<HTMLElement>(
            `[data-error="${field}"]`,
          );
          if (target && !target.textContent) {
            target.textContent = issue.message;
            target.classList.remove('hidden');
          }
        }
        return;
      }
      const message = buildContactMessage(result.data, lang);
      const waUrl = whatsappUrl(message);
      if (waLink) waLink.href = waUrl;
      if (mailtoLink)
        mailtoLink.href = `mailto:${SITE_EMAIL}?subject=${encodeURIComponent('Contact — ' + result.data.nom)}&body=${encodeURIComponent(message)}`;
      copyBtn?.addEventListener('click', () =>
        navigator.clipboard.writeText(message),
      );
      window.open(waUrl, '_blank', 'noopener');
      trackEvent(EVENTS.formulaireContact, { salle: result.data.salle });
      success?.classList.remove('hidden');
      success?.classList.add('flex');
      success?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
</script>
