---
import {
  sallesLabels,
  objectifsLabels,
  objectifsLabelsEn,
  niveauxLabels,
  niveauxLabelsEn,
} from '../../lib/form';
import { SITE_EMAIL } from '../../lib/seo';
import type { Lang } from '../../i18n/ui';

export interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const en = lang === 'en';

const inputClass =
  'w-full rounded-card border border-white/15 bg-dark-primary px-4 py-3 text-sm text-light-primary placeholder:text-light-primary/40 focus:border-brand-magenta focus:outline-none';
const labelClass =
  'mb-1 block font-mono text-xs tracking-widest uppercase text-light-primary/70';
const errorClass = 'mt-1 hidden font-mono text-xs text-brand-orange';

const objectifs = en ? objectifsLabelsEn : objectifsLabels;
const niveaux = en ? niveauxLabelsEn : niveauxLabels;
---

<form data-essai-form data-lang={lang} class="flex flex-col gap-5" novalidate>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="essai-nom" class={labelClass}>
        {en ? 'Name *' : 'Nom *'}
      </label>
      <input
        id="essai-nom"
        name="nom"
        type="text"
        autocomplete="name"
        required
        class={inputClass}
        placeholder="Awa Diop"
      />
      <p data-error="nom" class={errorClass}></p>
    </div>
    <div>
      <label for="essai-tel" class={labelClass}>
        {en ? 'Phone *' : 'Téléphone *'}
      </label>
      <input
        id="essai-tel"
        name="telephone"
        type="tel"
        autocomplete="tel"
        required
        class={inputClass}
        placeholder="77 123 45 67"
      />
      <p data-error="telephone" class={errorClass}></p>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="essai-email" class={labelClass}>
        {en ? 'Email (optional)' : 'Email (optionnel)'}
      </label>
      <input
        id="essai-email"
        name="email"
        type="email"
        autocomplete="email"
        class={inputClass}
        placeholder={en ? 'you@example.com' : 'vous@exemple.com'}
      />
      <p data-error="email" class={errorClass}></p>
    </div>
    <div>
      <label for="essai-salle" class={labelClass}>
        {en ? 'Which gym? *' : 'Quelle salle ? *'}
      </label>
      <select id="essai-salle" name="salle" required class={inputClass}>
        {Object.entries(sallesLabels).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
      <p data-error="salle" class={errorClass}></p>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="essai-objectif" class={labelClass}>
        {en ? 'Your goal *' : 'Votre objectif *'}
      </label>
      <select id="essai-objectif" name="objectif" required class={inputClass}>
        {Object.entries(objectifs).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
      <p data-error="objectif" class={errorClass}></p>
    </div>
    <div>
      <label for="essai-niveau" class={labelClass}>
        {en ? 'Your level *' : 'Votre niveau *'}
      </label>
      <select id="essai-niveau" name="niveau" required class={inputClass}>
        {Object.entries(niveaux).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
      <p data-error="niveau" class={errorClass}></p>
    </div>
  </div>

  <div>
    <label for="essai-message" class={labelClass}>
      {en ? 'Free message' : 'Message libre'}
    </label>
    <textarea
      id="essai-message"
      name="message"
      rows="4"
      class={inputClass}
      placeholder={
        en
          ? 'Preferred time slots, questions, medical history…'
          : 'Créneaux préférés, questions, antécédents…'
      }
    ></textarea>
    <p data-error="message" class={errorClass}></p>
  </div>

  <button
    type="submit"
    class="rounded-pill bg-gradient-brand px-8 py-4 text-base font-semibold text-white transition hover:-translate-y-0.5 hover:brightness-110"
  >
    {en ? 'Send my free trial request' : "Envoyer ma demande d'essai gratuit"}
  </button>
  <p class="text-xs text-light-primary/55">
    {en ? (
      <>
        * Required fields. Your request opens pre-filled in WhatsApp; an email
        copy to {SITE_EMAIL} is offered at confirmation.
      </>
    ) : (
      <>
        * Champs obligatoires. Votre demande part sur WhatsApp prérempli ; une
        copie email vers {SITE_EMAIL} est proposée à la confirmation.
      </>
    )}
  </p>

  <div
    data-essai-success
    class="hidden flex-col gap-4 rounded-card border border-brand-cyan/40 bg-brand-cyan/10 p-6"
    role="status"
  >
    <p class="font-semibold text-brand-cyan">
      {en
        ? 'Thank you! Your message is ready to send.'
        : 'Merci ! Votre message est prêt à partir.'}
    </p>
    <p class="text-sm text-light-primary/80">
      {en
        ? "WhatsApp opened with your pre-filled request. If it didn't, use the buttons below."
        : "WhatsApp s'est ouvert avec votre demande préremplie. Si ce n'est pas le cas, utilisez les boutons ci-dessous."}
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        data-success-whatsapp
        href="#"
        target="_blank"
        rel="noopener"
        class="rounded-pill bg-[#25D366] px-5 py-2.5 text-sm font-semibold text-white"
      >
        {en ? 'Open WhatsApp' : 'Ouvrir WhatsApp'}
      </a>
      <a
        data-success-mailto
        href="#"
        class="rounded-pill border border-white/25 px-5 py-2.5 text-sm font-semibold"
      >
        {en ? 'Send by email' : 'Envoyer par email'}
      </a>
      <button
        type="button"
        data-success-copy
        class="rounded-pill border border-white/25 px-5 py-2.5 text-sm font-semibold"
      >
        {en ? 'Copy message' : 'Copier le message'}
      </button>
    </div>
  </div>
</form>

<script>
  import {
    essaiSchema,
    essaiSchemaEn,
    buildEssaiMessage,
  } from '../../lib/form';
  import { whatsappUrl } from '../../lib/whatsapp';
  import { SITE_EMAIL } from '../../lib/seo';
  import { trackEvent, EVENTS } from '../../lib/analytics';

  const form = document.querySelector<HTMLFormElement>('[data-essai-form]');
  if (form) {
    const lang = form.dataset.lang === 'en' ? 'en' : 'fr';
    const schema = lang === 'en' ? essaiSchemaEn : essaiSchema;
    const success = form.querySelector<HTMLElement>('[data-essai-success]');
    const waLink = form.querySelector<HTMLAnchorElement>(
      '[data-success-whatsapp]',
    );
    const mailtoLink = form.querySelector<HTMLAnchorElement>(
      '[data-success-mailto]',
    );
    const copyBtn = form.querySelector<HTMLButtonElement>(
      '[data-success-copy]',
    );

    const clearErrors = () =>
      form.querySelectorAll('[data-error]').forEach((el) => {
        el.textContent = '';
        el.classList.add('hidden');
      });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearErrors();
      const data = Object.fromEntries(new FormData(form).entries());
      const result = schema.safeParse(data);
      if (!result.success) {
        for (const issue of result.error.issues) {
          const field = String(issue.path[0]);
          const target = form.querySelector<HTMLElement>(
            `[data-error="${field}"]`,
          );
          if (target && !target.textContent) {
            target.textContent = issue.message;
            target.classList.remove('hidden');
          }
        }
        return;
      }
      const message = buildEssaiMessage(result.data, lang);
      const waUrl = whatsappUrl(message);
      if (waLink) waLink.href = waUrl;
      if (mailtoLink)
        mailtoLink.href = `mailto:${SITE_EMAIL}?subject=${encodeURIComponent((lang === 'en' ? 'Free trial request — ' : "Demande d'essai gratuit — ") + result.data.nom)}&body=${encodeURIComponent(message)}`;
      copyBtn?.addEventListener('click', () =>
        navigator.clipboard.writeText(message),
      );
      window.open(waUrl, '_blank', 'noopener');
      trackEvent(EVENTS.formulaireEssai, {
        salle: result.data.salle,
        objectif: result.data.objectif,
      });
      success?.classList.remove('hidden');
      success?.classList.add('flex');
      success?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
</script>
