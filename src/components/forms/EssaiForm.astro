---
import { sallesLabels, objectifsLabels, niveauxLabels } from '../../lib/form';
import { SITE_EMAIL } from '../../lib/seo';

const inputClass =
  'w-full rounded-card border border-white/15 bg-dark-primary px-4 py-3 text-sm text-light-primary placeholder:text-light-primary/40 focus:border-brand-magenta focus:outline-none';
const labelClass =
  'mb-1 block font-mono text-xs tracking-widest uppercase text-light-primary/70';
const errorClass = 'mt-1 hidden font-mono text-xs text-brand-orange';
---

<form data-essai-form class="flex flex-col gap-5" novalidate>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="essai-nom" class={labelClass}>
        Nom *
      </label>
      <input
        id="essai-nom"
        name="nom"
        type="text"
        autocomplete="name"
        required
        class={inputClass}
        placeholder="Awa Diop"
      />
      <p data-error="nom" class={errorClass}></p>
    </div>
    <div>
      <label for="essai-tel" class={labelClass}>
        Téléphone *
      </label>
      <input
        id="essai-tel"
        name="telephone"
        type="tel"
        autocomplete="tel"
        required
        class={inputClass}
        placeholder="77 123 45 67"
      />
      <p data-error="telephone" class={errorClass}></p>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="essai-email" class={labelClass}>
        Email (optionnel)
      </label>
      <input
        id="essai-email"
        name="email"
        type="email"
        autocomplete="email"
        class={inputClass}
        placeholder="vous@exemple.com"
      />
      <p data-error="email" class={errorClass}></p>
    </div>
    <div>
      <label for="essai-salle" class={labelClass}>
        Quelle salle ? *
      </label>
      <select id="essai-salle" name="salle" required class={inputClass}>
        {Object.entries(sallesLabels).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
      <p data-error="salle" class={errorClass}></p>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="essai-objectif" class={labelClass}>
        Votre objectif *
      </label>
      <select id="essai-objectif" name="objectif" required class={inputClass}>
        {Object.entries(objectifsLabels).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
      <p data-error="objectif" class={errorClass}></p>
    </div>
    <div>
      <label for="essai-niveau" class={labelClass}>
        Votre niveau *
      </label>
      <select id="essai-niveau" name="niveau" required class={inputClass}>
        {Object.entries(niveauxLabels).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
      <p data-error="niveau" class={errorClass}></p>
    </div>
  </div>

  <div>
    <label for="essai-message" class={labelClass}>
      Message libre
    </label>
    <textarea
      id="essai-message"
      name="message"
      rows="4"
      class={inputClass}
      placeholder="Créneaux préférés, questions, antécédents…"
    ></textarea>
    <p data-error="message" class={errorClass}></p>
  </div>

  <button
    type="submit"
    class="rounded-pill bg-gradient-brand px-8 py-4 text-base font-semibold text-white transition hover:-translate-y-0.5 hover:brightness-110"
  >
    Envoyer ma demande d'essai gratuit
  </button>
  <p class="text-xs text-light-primary/55">
    * Champs obligatoires. Votre demande part sur WhatsApp prérempli ; une copie
    email vers {SITE_EMAIL} est proposée à la confirmation.
  </p>

  <div
    data-essai-success
    class="hidden flex-col gap-4 rounded-card border border-brand-cyan/40 bg-brand-cyan/10 p-6"
    role="status"
  >
    <p class="font-semibold text-brand-cyan">
      Merci ! Votre message est prêt à partir.
    </p>
    <p class="text-sm text-light-primary/80">
      WhatsApp s'est ouvert avec votre demande préremplie. Si ce n'est pas le
      cas, utilisez les boutons ci-dessous.
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        data-success-whatsapp
        href="#"
        target="_blank"
        rel="noopener"
        class="rounded-pill bg-[#25D366] px-5 py-2.5 text-sm font-semibold text-white"
      >
        Ouvrir WhatsApp
      </a>
      <a
        data-success-mailto
        href="#"
        class="rounded-pill border border-white/25 px-5 py-2.5 text-sm font-semibold"
      >
        Envoyer par email
      </a>
      <button
        type="button"
        data-success-copy
        class="rounded-pill border border-white/25 px-5 py-2.5 text-sm font-semibold"
      >
        Copier le message
      </button>
    </div>
  </div>
</form>

<script>
  import { essaiSchema, buildEssaiMessage } from '../../lib/form';
  import { whatsappUrl } from '../../lib/whatsapp';
  import { SITE_EMAIL } from '../../lib/seo';
  import { trackEvent, EVENTS } from '../../lib/analytics';

  const form = document.querySelector<HTMLFormElement>('[data-essai-form]');
  if (form) {
    const success = form.querySelector<HTMLElement>('[data-essai-success]');
    const waLink = form.querySelector<HTMLAnchorElement>(
      '[data-success-whatsapp]',
    );
    const mailtoLink = form.querySelector<HTMLAnchorElement>(
      '[data-success-mailto]',
    );
    const copyBtn = form.querySelector<HTMLButtonElement>(
      '[data-success-copy]',
    );

    const clearErrors = () =>
      form.querySelectorAll('[data-error]').forEach((el) => {
        el.textContent = '';
        el.classList.add('hidden');
      });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearErrors();
      const data = Object.fromEntries(new FormData(form).entries());
      const result = essaiSchema.safeParse(data);
      if (!result.success) {
        for (const issue of result.error.issues) {
          const field = String(issue.path[0]);
          const target = form.querySelector<HTMLElement>(
            `[data-error="${field}"]`,
          );
          if (target && !target.textContent) {
            target.textContent = issue.message;
            target.classList.remove('hidden');
          }
        }
        return;
      }
      const message = buildEssaiMessage(result.data);
      const waUrl = whatsappUrl(message);
      if (waLink) waLink.href = waUrl;
      if (mailtoLink)
        mailtoLink.href = `mailto:${SITE_EMAIL}?subject=${encodeURIComponent("Demande d'essai gratuit — " + result.data.nom)}&body=${encodeURIComponent(message)}`;
      copyBtn?.addEventListener('click', () =>
        navigator.clipboard.writeText(message),
      );
      window.open(waUrl, '_blank', 'noopener');
      trackEvent(EVENTS.formulaireEssai, {
        salle: result.data.salle,
        objectif: result.data.objectif,
      });
      success?.classList.remove('hidden');
      success?.classList.add('flex');
      success?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
</script>
