---
import Eyebrow from './Eyebrow.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'left',
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'flex flex-col gap-3',
    align === 'center' ? 'items-center text-center' : 'items-start',
    className,
  ]}
>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2 class="text-3xl font-bold text-balance sm:text-4xl">{title}</h2>
  {subtitle && <p class="max-w-2xl text-light-primary/70 pretty">{subtitle}</p>}
</div>
