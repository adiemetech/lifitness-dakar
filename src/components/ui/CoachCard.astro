---
import { Image } from 'astro:assets';
import type { Coach } from '../../data/coachs';
import type { Lang } from '../../i18n/ui';
import coachPortrait from '../../assets/images/coachs/coach-bras-croises.png';

export interface Props {
  coach: Coach;
  lang?: Lang;
}

const { coach, lang = 'fr' } = Astro.props;
---

<article class="flex h-full flex-col overflow-hidden rounded-card border border-white/10 bg-dark-secondary">
  {coach.photo ? (
    <Image
      src={coachPortrait}
      alt={
        lang === 'en' ? `Portrait of ${coach.nom}` : `Portrait de ${coach.nom}`
      }
      sizes="(min-width: 768px) 33vw, 100vw"
      class="aspect-[4/5] w-full object-cover object-top"
    />
  ) : (
    <div class="grid aspect-[4/5] w-full place-items-center bg-gradient-brand">
      <span class="font-display text-6xl font-bold text-white/90">
        {coach.specialite.charAt(0)}
      </span>
    </div>
  )}
  <div class="flex flex-1 flex-col gap-2 p-6">
    <p class="font-mono text-xs tracking-[0.25em] text-brand-cyan uppercase">
      {coach.specialite}
    </p>
    <h3 class="text-xl font-bold">{coach.nom}</h3>
    <p class="text-sm text-light-primary/70 pretty">{coach.bio}</p>
  </div>
</article>
