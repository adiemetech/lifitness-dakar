---
export interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="flex flex-col gap-3">
  {items.map((item) => (
    <details class="group rounded-card border border-white/10 bg-dark-secondary">
      <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-semibold transition hover:text-brand-pink">
        {item.question}
        <span
          class="font-mono text-brand-cyan transition-transform group-open:rotate-45"
          aria-hidden="true"
        >
          +
        </span>
      </summary>
      <p class="px-5 pb-5 text-sm text-light-primary/75 pretty">
        {item.answer}
      </p>
    </details>
  ))}
</div>
