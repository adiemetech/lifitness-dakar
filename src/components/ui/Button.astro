---
export interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className,
} = Astro.props;

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary:
    'bg-gradient-brand text-white shadow-lg shadow-brand-magenta/25 hover:brightness-110',
  outline:
    'border border-white/25 text-light-primary hover:border-brand-magenta hover:text-brand-pink',
  ghost: 'text-brand-cyan hover:text-brand-pink hover:underline',
};

const sizes: Record<NonNullable<Props['size']>, string> = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-pill font-semibold tracking-wide transition hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-cyan',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>
  <slot />
</a>
