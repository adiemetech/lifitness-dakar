---
import SectionHeader from '../ui/SectionHeader.astro';
import ProgrammeCard from '../ui/ProgrammeCard.astro';
import { programmes } from '../../data/programmes';

const apercu = [
  'musculation',
  'collectifs',
  'boxe',
  'ems',
  'aquatique',
  'sauna',
];
const selection = programmes.filter((p) => apercu.includes(p.slug));
---

<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <SectionHeader
    eyebrow="Services & équipements"
    title="Tout ce qu'il faut pour progresser. Rien de superflu."
    subtitle="Plateaux complets, cours collectifs signés Les Mills, ring de boxe, EMS, pôle aquatique et sauna. Choisis ton terrain de jeu."
  />
  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {selection.map((p) => (
      <ProgrammeCard programme={p} />
    ))}
  </div>
</section>
