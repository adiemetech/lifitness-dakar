---
import PageLayout from './PageLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { article, breadcrumbList } from '../lib/seo';
import type { Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/routes';

export interface Props {
  title: string;
  description: string;
  date: Date;
  author: string;
  tags?: string[];
  path: string;
  lang?: Lang;
}

const {
  title,
  description,
  date,
  author,
  tags = [],
  path,
  lang = 'fr',
} = Astro.props;
const en = lang === 'en';

const dateLisible = date.toLocaleDateString(en ? 'en-US' : 'fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<PageLayout
  lang={lang}
  title={
    en ? `${title} | Lifitness Dakar Blog` : `${title} | Blog Lifitness Dakar`
  }
  description={description}
  path={path}
  jsonLd={[
    breadcrumbList(
      en
        ? [
            { name: 'Home', path: '/en/' },
            { name: 'Blog', path: '/en/blog' },
            { name: title, path },
          ]
        : [
            { name: 'Accueil', path: '/' },
            { name: 'Blog', path: '/blog' },
            { name: title, path },
          ],
    ),
    article({
      title,
      description,
      datePublished: date.toISOString(),
      author,
      path,
    }),
  ]}
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8 sm:px-6">
    <nav aria-label={en ? 'Breadcrumb' : "Fil d'Ariane"} class="mb-6">
      <ol class="flex gap-2 font-mono text-xs text-light-primary/60">
        <li>
          <a href={localizedPath('/', lang)} class="hover:text-brand-pink">
            {en ? 'Home' : 'Accueil'}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={localizedPath('/blog', lang)} class="hover:text-brand-pink">
            Blog
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-light-primary">{en ? 'Article' : 'Article'}</li>
      </ol>
    </nav>
    <Eyebrow>{tags.length > 0 ? tags.join(' · ') : 'Blog'}</Eyebrow>
    <h1 class="mt-4 text-3xl font-bold text-balance sm:text-4xl">{title}</h1>
    <p class="mt-4 text-lg text-light-primary/75 pretty">{description}</p>
    <p class="mt-6 font-mono text-xs text-light-primary/55">
      {dateLisible} — {author}
    </p>
  </section>

  <article class="mx-auto max-w-3xl px-4 pb-16 text-base leading-relaxed text-light-primary/85 sm:px-6 [&_a]:text-brand-cyan [&_a]:underline [&_a:hover]:text-brand-pink [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-light-primary [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-light-primary [&_li]:mt-2 [&_ol]:mt-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-5 [&_strong]:font-semibold [&_strong]:text-light-primary [&_ul]:mt-6 [&_ul]:list-disc [&_ul]:pl-6">
    <slot />
  </article>

  <FinalCTA lang={lang} />
</PageLayout>
