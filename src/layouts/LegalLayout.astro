---
import PageLayout from './PageLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { breadcrumbList } from '../lib/seo';
import { dateMaj } from '../data/legal';
import type { Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/routes';

export interface Props {
  title: string;
  description: string;
  path: string;
  pageName: string;
  lang?: Lang;
}

const { title, description, path, pageName, lang = 'fr' } = Astro.props;
const en = lang === 'en';
const dateMajEn = 'September 25, 2026';
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  jsonLd={breadcrumbList(
    en
      ? [
          { name: 'Home', path: '/en/' },
          { name: pageName, path },
        ]
      : [
          { name: 'Accueil', path: '/' },
          { name: pageName, path },
        ],
  )}
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-20 sm:px-6">
    <nav aria-label={en ? 'Breadcrumb' : "Fil d'Ariane"} class="mb-6">
      <ol class="flex gap-2 font-mono text-xs text-light-primary/60">
        <li>
          <a href={localizedPath('/', lang)} class="hover:text-brand-pink">
            {en ? 'Home' : 'Accueil'}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-light-primary">{pageName}</li>
      </ol>
    </nav>
    <Eyebrow>{en ? 'Legal information' : 'Informations légales'}</Eyebrow>
    <h1 class="mt-4 text-3xl font-bold text-balance sm:text-4xl">{pageName}</h1>
    <p class="mt-3 font-mono text-xs text-light-primary/55">
      {en ? 'Last updated:' : 'Dernière mise à jour :'}{' '}
      {en ? dateMajEn : dateMaj}
    </p>
    <div class="mt-10 text-base leading-relaxed text-light-primary/85 [&_a]:text-brand-cyan [&_a]:underline [&_a:hover]:text-brand-pink [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-light-primary [&_h3]:mt-8 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-light-primary [&_li]:mt-2 [&_p]:mt-5 [&_strong]:font-semibold [&_strong]:text-light-primary [&_ul]:mt-5 [&_ul]:list-disc [&_ul]:pl-6">
      <slot />
    </div>
  </section>
</PageLayout>
